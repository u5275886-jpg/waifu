# ═══════════════════════════════════════════════════════════════
#   ZEXIS WAIFU BOT — Environment Configuration
#   Copy this file to .env and fill in your real values.
#   Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Telegram API (https://my.telegram.org) ─────────────────────
API_ID=37729457
API_HASH=bb68973b7efcbbd074cda984c95502d6

# ── Bot token (from @BotFather) ────────────────────────────────
BOT_TOKEN=123456789:

# ── Your personal Telegram user ID (get it from @userinfobot) ──
BOT_OWNER=7524032836

# ── MongoDB ────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net
MONGO_URI=mongodb://localhost:27017
DB_NAME=zolvid

# ── Redis ──────────────────────────────────────────────────────
# Local:  redis://localhost:6379/0
# Remote: redis://:<password>@<host>:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Gacha tuning (optional overrides) ─────────────────────────
SPAWN_AFTER=100
SPAWN_TIMEOUT=300
